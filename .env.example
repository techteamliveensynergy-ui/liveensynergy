# Supabase project credentials — copy to .env.local and fill in
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key (used by admin/service tasks — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Survey bot/fraud screen (Cloudflare Turnstile) --------------------------
# Free Turnstile widget from dash.cloudflare.com. Unset in development, the
# survey bot screen is skipped with a warning; unset in *production* the
# survey submission is refused outright, so a missing key can never silently
# disable the gate. Cloudflare's dummy keys pass deterministically and are
# what local dev and the Playwright suite should use:
#   site 1x00000000000000000000BB / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Peppers the SHA-256 hash of the caller's IP behind per-IP rate limiting, so
# raw addresses are never stored. Any long random string. Unset still rate-
# limits — the hash is just unsalted, and therefore reversible.
SURVEY_IP_SALT=

# --- In-app feedback → GitHub issues (optional) ------------------------------
# When both of these are set, every report submitted through the feedback
# widget is also raised as an issue on the repo below. Leave them unset and the
# widget still works — reports just stay in the admin Feedback inbox.
# The token needs a fine-grained PAT with Issues: read & write on that repo.
GITHUB_FEEDBACK_REPO=owner/repo
GITHUB_TOKEN=
# Comma separated, applied to every raised issue. Defaults to "feedback".
GITHUB_FEEDBACK_LABELS=feedback,beta
